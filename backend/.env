# Google Gemini API Key (Required for chat and memory embeddings)
GEMINI_API_KEY=AQ.Ab8RN6K6cfOCPDkG1MlJLtSzmGYih4-nCq_zDZkNQ2lBB8_zfw

# Model Configuration (Optional, defaults to gemini-3.6-flash)
